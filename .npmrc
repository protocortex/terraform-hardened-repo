# Managed by repo-config. Direct edits are overwritten on next terraform apply.
#
# Hardened pnpm defaults for all JS/TS repos.
#
# strict-peer-dependencies: abort install if peer deps are not satisfied.
# shamefully-hoist: keep node_modules isolated (phantom-dep prevention).
# prefer-frozen-lockfile: fail if lockfile needs updating (CI parity).
# resolution-mode: always resolve to the highest satisfying version, not
#   the lowest, so range vulnerabilities don't linger at old patch levels.
# auto-install-peers: never silently pull in unspecified peers.
# lockfile-include-tarball-url: embed registry URL in lockfile so auditing
#   tools can correlate resolved packages to their source without a
#   separate registry fetch.
strict-peer-dependencies=true
shamefully-hoist=false
prefer-frozen-lockfile=true
resolution-mode=highest
auto-install-peers=false
lockfile-include-tarball-url=true
